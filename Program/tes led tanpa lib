#define F_CPU 16000000UL  // Clock 16 MHz
#include <avr/io.h>
#include <util/delay.h>

int main(void) {
    // Set PD6 sebagai output
    DDRD |= (1 << PD6);

    while (1) {
        // Nyalakan LED
        PORTD |= (1 << PD6);
        _delay_ms(500);

        // Matikan LED
        PORTD &= ~(1 << PD6);
        _delay_ms(500);
    }
}
